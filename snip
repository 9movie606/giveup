    { status: 200, headers: { 'content-type': 'text/plain; charset=UTF-8' } }
  );
}

/** 跨账号配置推送接收（POST /api/sync/receive-config；X-Sync-Key 鉴权） */
const handleSyncConfig = async (request) => {
  const db = runtimeEnv?.Senflare;
  if (!safeEqual(request.headers.get('X-Sync-Key'), SyncKey)) return new Response('Not Found', { status: 404 });
  const json = (data, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json' } });
  if (!db) return json({ error: '未绑定 D1，无法接收配置' }, 503);
  // 推送体上限：白名单键值全是短内容，64KB 绰绰有余，防异常大包进 JSON 解析
  if (Number(request.headers.get('content-length') || 0) > 65536) return json({ error: '推送体过大' }, 413);
  let body;
  try { body = await request.json(); } catch { return json({ error: '参数错误' }, 400); }
  const entries = Object.entries(body && typeof body === 'object' ? body : {})
    .filter(([k, v]) => ConfigKeys.includes(k) && ['string', 'boolean', 'number'].includes(typeof v));
  if (!entries.length) return json({ error: '无有效配置项' }, 400);
  const enc = (v) => (typeof v === 'string' ? v : JSON.stringify(v));
  const upsert = 'INSERT INTO config (key, value, updatedAt) VALUES (?, ?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value, updatedAt = excluded.updatedAt';
  const runBatch = () => {
    const now = Date.now();
    return db.batch(entries.map(([k, v]) => db.prepare(upsert).bind(k, enc(v), now)));
  };
  try {
    await runBatch();
  } catch {
    // 缺表时补建一次再试
    try {
      await db.prepare('CREATE TABLE IF NOT EXISTS config (key TEXT PRIMARY KEY, value TEXT NOT NULL, updatedAt INTEGER NOT NULL)').run();
      await runBatch();
    } catch { return json({ error: '写入失败' }, 500); }
  }
  nodeConf = null;  // 立即失效缓存
  nodeConfTime = 0;
  nodeConfFailUntil = 0;
  confGeneration++;   // 推进代数：读取快照早于本次提交的在途加载将被弃用重读，防止旧值回填
  return json({ success: true, version: AdminVersion });   // 供主后端版本对账
};

// ==================== 6. 会话入口：WebSocket / XHTTP ====================

const handleWebSocketConn = async (webSocket, request) => {
  const hostHeader = request.headers.get('host') || '';
  const referer = request.headers.get('Referer');
  let earlyDataHeader = request.headers.get('sec-websocket-protocol');
  if (!earlyDataHeader && referer && hostHeader) {
    // Referer 早数据：完整 URL 解析后比对 host（直接 startsWith(host) 对带 scheme 的 Referer 永假）
    try {
      const refUrl = new URL(referer);
      if (refUrl.host === hostHeader) {
        const tail = (refUrl.pathname + refUrl.search).replace(/^\/+/, '');
        earlyDataHeader = tail || null;
      }
    } catch { }   // 畸形 Referer 视作无早数据
  }
  let earlyData = null;
  if (earlyDataHeader) {
    try {
      earlyData = Uint8Array.fromBase64(earlyDataHeader, { alphabet: 'base64url', lastChunkHandling: 'loose' });
    } catch { }   // 畸形 early-data 直接丢弃：异常抛出会让已 accept 的 WebSocket 成无人接管
  }
  const state = { upQueue: null, tcpSocket: null, udpRemain: null, tcpDns: null, dnsRemain: null, dnsIdleTimer: null, exitKey: null };
  let closing = false;
  const finalizeClose = () => {
    state.dnsIdleTimer && (clearTimeout(state.dnsIdleTimer), (state.dnsIdleTimer = null));
    try { state.tcpSocket?.close(); } catch { }
  };
  // silent=true：服务端主动掐线，静默回收不发 close 帧；silent=false：会话正常完成，发 1000 关闭
  const close = (silent) => {
    if (closing) return;
    closing = true;
    if (!silent) {
      try { webSocket.close(1000); } catch { }
    }
    state.upQueue ? state.upQueue.onIdle(finalizeClose) : finalizeClose();
  };
  const processingQueue = createAsyncMicrotaskQueue((chunk) => handleSession(chunk, state, request, webSocket, close), close);
  state.upQueue = processingQueue;
  if (earlyData) processingQueue(earlyData);
  webSocket.addEventListener('message', (event) => processingQueue(event.data));
  webSocket.addEventListener('error', () => close(true));
  webSocket.addEventListener('close', () => close(true));
};

const xwebHeaders = {
  'Content-Type': 'application/octet-stream',
  'grpc-status': '0',
  'X-Accel-Buffering': 'no',
  'Cache-Control': 'no-store',
};

/** XHTTP 首字节看门狗：竞速首个下行块，'timeout'=静默超时（调用方记失败记忆）、null=EOF/错误；
 *  成功返回 { tcpReader, first }，reader 释放后其余下行仍走 pipeTo */
const xwebFirstByte = async (socket) => {
  const tcpReader = socket.readable.getReader();
  const fbt = await getFirstByteTimeout();
  const firstRead = tcpReader.read();
  firstRead.catch(() => { });   // 竞速败者拒绝兜底
  let watchdog;
  const first = await Promise.race([
    firstRead.finally(() => clearTimeout(watchdog)),
    new Promise((resolve) => { watchdog = setTimeout(resolve, fbt); }),
  ]).catch(() => null);
  if (!first?.value?.byteLength) {
    try { tcpReader.cancel().catch(() => { }); } catch { }
    try { tcpReader.releaseLock(); } catch { }
    return first === undefined ? 'timeout' : null;   // 仅静默超时判黑洞
  }
  return { tcpReader, first: first.value };
};

const handleXwebPost = async (request) => {
  if (!request.body) return new Response(null, { status: 400 });
  const state = { tcpSocket: null, needMore: false, xwebPipeTo: true, udpRemain: null, tcpDns: null, dnsRemain: null, dnsIdleTimer: null, exitKey: null };
  const bridge = new IdentityTransformStream();
  const responseWriter = bridge.writable.getWriter();
  let xwebBuffer = new ArrayBuffer(maxChunkLen);
  let used = 0;
  const close = () => {
    state.dnsIdleTimer && (clearTimeout(state.dnsIdleTimer), (state.dnsIdleTimer = null));
    try { state.tcpSocket?.close(); } catch { }
    if (state.xwebPipeTo) responseWriter.close().catch(() => { });
  };
  const writable = { send(chunk) { if (chunk?.byteLength) return responseWriter.write(chunk); } };
  const reader = request.body.getReader({ mode: 'byob' });
  (async () => {
    // 首包阶段：手动拼读到建连成功
    while (!state.tcpSocket) {
      const readLen = used === 0 ? 16 * 1024 : maxChunkLen - used;
      if (readLen <= 0) return close();
      const { done, value } = await reader.read(new Uint8Array(xwebBuffer, used, readLen));
      if (done) return close();
      xwebBuffer = value.buffer;
      used += value.byteLength;
      state.needMore = false;
      await handleSession(new Uint8Array(xwebBuffer, 0, used), state, request, writable, close);
      if (!state.needMore) used = 0;   // 解析完成即重置
    }
    // 建连成功：上行剩余裸流 pipeTo
    reader.releaseLock();
    request.body.pipeTo(state.tcpSocket.writable).catch(close);
    if (state.xwebPipeTo) {
      const got = await xwebFirstByte(state.tcpSocket);
      if (got === 'timeout') {
        if (state.exitKey) markProxyKey(state.exitKey);   // 黑洞出口记入失败记忆
        return close();
      }
      if (!got) return close();   // EOF/错误：掐断但不记出口
      await writable.send(got.first);   // 首块落桥
      try { got.tcpReader.releaseLock(); } catch { }
      state.xwebPipeTo = false;
      responseWriter.releaseLock();
      state.tcpSocket.readable.pipeTo(bridge.writable).catch(close);
    }
  })().catch(close);
  return new Response(bridge.readable, { headers: xwebHeaders });
};

// ==================== 7. 会话管理 ====================

// 测速回环：目标是 CF 测速域时隧道内直接回 204
const SPEED_TEST_HOSTS = ['speed.cloudflare.com', 'cp.cloudflare.com'];
const isSpeedTestHost = (h) => {
  h = String(h || '').toLowerCase();
  return SPEED_TEST_HOSTS.some((d) => h === d || h.endsWith('.' + d));
};
/** 回环应答（预编码为字节） */
const SPEED_TEST_204 = textEncoder.encode('HTTP/1.1 204 No Content\r\nconnection: keep-alive\r\n\r\n');

const handleSession = async (chunk, state, request, writable, close) => {
  // 回环模式：每收到一段数据回一个 204
  if (state.speedLoop) {
    if (chunk?.byteLength) await writable.send(SPEED_TEST_204);
    return;
  }
  if (state.tcpDns) {
    await feedTcpDns(chunk, state, writable, close);
    return;
  }
  if (state.udpDns) {
    await feedUdpDns(chunk, state, writable, close);
    return;
  }
  state.needMore = false;
  if (state.pendingHeader) {
    const merged = new Uint8Array(state.pendingHeader.length + chunk.length);
    merged.set(state.pendingHeader, 0);
    merged.set(chunk, state.pendingHeader.length);
    state.pendingHeader = null;
    chunk = merged;
  }
  const parsed = parseProtocolChunk(chunk);
  if (parsed.handshake) writable.send(parsed.handshake);
  if (!parsed.success) {
    // 仅 WS 路径留存残帧（XHTTP 由调用方缓冲）
    if (parsed.needMore) { state.needMore = true; if (!state.xwebPipeTo) state.pendingHeader = chunk.slice(); return; }
    return close(true);   // 鉴权失败：静默断开
  }
  const parsedRequest = parsed.parsedRequest;
  const payload = chunk.subarray(parsedRequest.dataOffset);

  // 53 端口：转 DoH 劫持
  if (parsedRequest.port === 53) {
    if (parsedRequest.cmd === 1) {
      state.tcpDns = true;
      await feedTcpDns(payload, state, writable, close);
      return;
    }
    state.udpDns = true;
    await feedUdpDns(payload, state, writable, close);
    return;
  }

  // 其他 UDP/MUX：不支持，回 3 字节失败握手
  if (parsedRequest.cmd !== 1) {
    if (!state.unsupported) {
      state.unsupported = true;   // 挡板：同一会话只回一次失败握手
      await writable.send(new Uint8Array([0x00, 0x01, 0x00]));
    }
    return;
  }

  // 目标地址解码
  const hostname = binaryAddrToString(parsedRequest.addrType, parsedRequest.addrBytes);

  // 测速域 → 进入回环模式
  if (isSpeedTestHost(hostname)) {
    state.speedLoop = true;
    await writable.send(SPEED_TEST_204);
    return;
  }

  // 首包由 establishTcpConnection 写入
  const tcpResult = await establishTcpConnection(parsedRequest, request, hostname, payload);
  if (!tcpResult) return close(true);   // 建连全灭：静默回收
  state.tcpSocket = tcpResult.socket;
  state.exitKey = tcpResult.exitKey;   // 黑洞看门狗触发时记失败记忆
  if (state.xwebPipeTo) return;   // XHTTP：上行由调用方接管
  state.upQueue.writer = state.tcpSocket.writable.getWriter();
  manualPipe(state.tcpSocket.readable, writable, close, () => state.exitKey && markProxyKey(state.exitKey)).catch(() => close(true));   // 下行异常/看门狗：静默回收
};

// ==================== 8. 协议解析 ====================

/** 解析协议头：Ver(1) + UUID(16) + OptLen(1) + Opt(N) + Cmd(1) + Port(2) + AddrType(1) + Addr(N) */
const parseProtocolChunk = (chunk) => {
  const len = chunk.length;
  const result = { success: false, needMore: false, handshake: null, parsedRequest: null };
  if (len < 17) return (result.needMore = true), result;
  const uuidKey = getUuidBytes();
  for (let i = 0; i < 16; i++) if (chunk[i + 1] !== uuidKey[i]) return result;
  if (len < 18) return (result.needMore = true), result;
  const offset = 19 + chunk[17];
  if (len < offset + 4) return (result.needMore = true), result;
  const addrType = chunk[offset + 2];
  const addrLen =
    addrType === 2
      ? offset + 3 < len
        ? chunk[offset + 3]
        : null
      : addrType === 1
        ? 4
        : addrType === 3
          ? 16
          : -1;
  if (addrLen === null) return (result.needMore = true), result;
  if (addrLen > 0) {
    const addrOffset = addrType === 2 ? offset + 4 : offset + 3;
    const dataOffset = addrOffset + addrLen;
    if (len < dataOffset) return (result.needMore = true), result;
    const port = (chunk[offset] << 8) | chunk[offset + 1];
    result.handshake = new Uint8Array([chunk[0], 0]);
    result.success = true;
    // cmd：0x01=TCP / 0x02=UDP / 0x03=MUX
    result.parsedRequest = { cmd: chunk[18 + chunk[17]], addrType, addrBytes: chunk.subarray(addrOffset, addrOffset + addrLen), dataOffset, port };
    return result;
  }
  return result;
};

