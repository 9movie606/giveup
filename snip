// 反向索引：colo → region
const coloToRegion = new Map();
for (const [region, colos] of Object.entries(colosByRegion)) {
  for (const colo of colos.split(' ')) if (colo) coloToRegion.set(colo, region);
}
const coloRegion = (c) => coloToRegion.get(c) || null;

// ==================== 10. 建立连接 ====================

/** TCP 建连超时（ms） */
const CONNECT_TIMEOUT = 1000;

const connectWithTimeout = async (hostname, port) => {
  // IPv6 字面量剥方括号
  if (hostname.charCodeAt(0) === 91 && hostname.endsWith(']')) hostname = hostname.slice(1, -1);
  const socket = connect({ hostname, port });
  let killer;
  try {
    await Promise.race([
      socket.opened,
      new Promise((_, reject) => {
        killer = setTimeout(() => reject(new Error('connect-timeout')), CONNECT_TIMEOUT);
      }),
    ]);
    return socket;
  } catch (e) {
    try { socket.close()?.catch?.(() => { }); } catch { }   // 关闭失败/超时的 socket
    throw e;
  } finally {
    clearTimeout(killer);
  }
};

/** 智能排序缓存 */
const smartProxyCache = new Map();

/** ProxyIP 排序：当前地区 → 邻近地区 → 其余 */
const getSmartProxyList = (region) => {
  if (smartProxyCache.has(region)) return smartProxyCache.get(region);
  const nearby = NearbyRegions[region] || [];
  const rank = (r) => (r === region ? 0 : nearby.includes(r) ? 1 : 2);
  const list = ProxyIPPool.filter((p) => p.domain)
    .map((p) => ({ domain: p.domain, r: rank(p.region) }))
    .sort((a, b) => a.r - b.r)   // 本区 → 邻区 → 其余；同 rank 保持池内顺序（稳定排序）
    .map((x) => x.domain);
  smartProxyCache.set(region, list);
  return list;
};

/** 按目标确定性洗牌 */
const stickyShuffle = (list, seedText) => {
  let seed = 0;
  for (let i = 0; i < seedText.length; i++) seed = (seed + seedText.charCodeAt(i)) | 0;
  const out = [...list];
  for (let i = out.length - 1; i > 0; i--) {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    const j = seed % (i + 1);
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
};

/** 解析反代候选（内联 > OFFICIAL > CUSTOM/LOCAL > 固定地区 > AUTO） */
const resolveProxyCandidates = async (conf, region = '', inlineExit = '', inlineExitPort = null, target = '', colo = '') => {
  const mode = String(conf.ProxyIPMode || 'AUTO').toUpperCase();

  if (inlineExit) return [{ host: inlineExit, port: inlineExitPort }];
  if (mode === 'OFFICIAL') return [{ host: officialProxyHost(colo), port: null }];

  // CUSTOM/LOCAL：过滤 URL 形态
  if (mode === 'CUSTOM' || mode === 'LOCAL') {
    const src = mode === 'LOCAL' ? conf.LocalProxyIP : conf.ProxyIP;
    const list = String(src || '')
      .split(/[\s,;]+/)
      .filter((s) => s && !/^https?:\/\//i.test(s) && !s.includes('/'))
      .map(parseHostPort)
      .filter((e) => e && /^(\[[\da-fA-F:]+\]|[\w.-]+)$/.test(e.host));
    if (list.length) return stickyShuffle(list, target + String(conf.UUID ?? ''));
  }

  // 固定地区
  if (/^[A-Z]{2}$/.test(mode)) {
    const hit = ProxyIPPool.find((p) => p.region === mode);
    return hit ? [{ host: hit.domain, port: null }] : [];
  }

  // AUTO：前 ProxyCandidateMax 个池域名预解析后按 IP 竞速
  const domains = getSmartProxyList(region).slice(0, ProxyCandidateMax);
  return (await Promise.all(domains.map(async (domain) =>
    (await resolveHostIps(domain)).map((ip) => ({ host: ip, port: null, via: domain }))
  ))).flat();
};

// ---------- Cloudflare 网段判定 ----------
const CfV4Cidrs = [
  '173.245.48.0/20', '103.21.244.0/22', '103.22.200.0/22', '103.31.4.0/22', '141.101.64.0/18',
  '108.162.192.0/18', '190.93.240.0/20', '188.114.96.0/20', '197.234.240.0/22', '198.41.128.0/17',
  '162.158.0.0/15', '104.16.0.0/13', '104.24.0.0/14', '172.64.0.0/13', '131.0.72.0/22',
].map((cidr) => {
  const [ip, bits] = cidr.split('/');
  const mask = (-1 << (32 - Number(bits))) >>> 0;
  const base = ip.split('.').reduce((n, s) => n * 256 + Number(s), 0) >>> 0;
  return [base & mask, mask];
});

const CfV6Heads = new Set(['2400:cb00', '2606:4700', '2803:f800', '2405:b500', '2405:8100', '2c0f:f248']);

const ipv4ToInt = (ip) => {
  const parts = ip.split('.');
  if (parts.length !== 4) return null;
  let n = 0;
  for (const s of parts) {
    const v = Number(s);
    if (!/^\d{1,3}$/.test(s) || v > 255) return null;
    n = n * 256 + v;
  }
  return n >>> 0;
};

/** 目标 IP 是否为 Cloudflare 网段 */
const isCfIp = (raw) => {
  let ip = String(raw || '');
  if (ip.charCodeAt(0) === 91) ip = ip.slice(1, ip.endsWith(']') ? -1 : undefined);
  if (ip.includes(':')) {
    const head = ip.toLowerCase().split(':').slice(0, 2).map((h) => h.replace(/^0+(?=.)/, '')).join(':');
    return CfV6Heads.has(head) || /^2a06:98c[0-7]$/.test(head);
  }
  const n = ipv4ToInt(ip);
  return n === null ? false : CfV4Cidrs.some(([base, mask]) => (n & mask) === base);
};

// ---------- 反代主机名 → IP 展开 ----------
const DnsTtl = 15 * 60 * 1000;
const DnsCacheMaxEntries = 256;
const dnsIpCache = new Map();

const isIpLiteral = (host) => host.charCodeAt(0) === 91 || /^\d{1,3}(\.\d{1,3}){3}$/.test(host);

/** DoH JSON 查 A（最多 4 个，失败回落原域名） */
const resolveHostIps = async (host) => {
  if (isIpLiteral(host)) return [host];
  const hit = dnsIpCache.get(host);
  if (hit && Date.now() - hit.time < DnsTtl) return hit.ips;
  const ips = [];
  // 只查 A（fetch/json 失败已在链内兜底为 null，无需外层捕获）
  const a = await fetchWithTimeout(`https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(host)}&type=A`, 3000, {
    headers: { accept: 'application/dns-json' },
  })
    .then((r) => (r.ok ? r.json() : null))
    .catch(() => null);
  for (const r of a?.Answer ?? []) if (r.type === 1 && typeof r.data === 'string') ips.push(r.data);
  if (!ips.length) {
    // 全灭时续用过期缓存
    if (hit) return hit.ips;
    return [host];
  }
  const out = ips.slice(0, 4);
  if (dnsIpCache.size >= DnsCacheMaxEntries) dnsIpCache.delete(dnsIpCache.keys().next().value);
  dnsIpCache.set(host, { ips: out, time: Date.now() });
  return out;
};

/** 连接日志：[路由] 目标 host:port | 出口 … | 入口 机房/国家/城市 | ASN
 *  直连出口即目标本身，显示「直连」；反代候选带来源域名时以「← 来自」标注 */
const logConn = (request, route, target, exitHost, targetPort, via = '') => {
  const cf = request?.cf || {};
  const exit = exitHost === target ? '直连' : (via && via !== exitHost ? `${exitHost} ← 来自 ${via}` : exitHost);
  const loc = [cf.colo, cf.country, cf.city].filter(Boolean).join(' / ') || '-';
  console.log(`[${route}] 目标 ${target}:${targetPort} | 出口 ${exit} | 入口 ${loc} | ASN ${cf.asn || '-'}`);
};

// ---------- 候选连接 ----------

const ProxyCandidateMax = 6;   // 候选上限
const ProxyDialBatch = 6;      // 每批并发连接数（对齐平台同时外连上限），失败 socket 立即关闭

/** 候选失败记忆：30s 内拨败的候选在多候选可选时跳过 */
const ProxyFailTtl = 30 * 1000;
const failedProxies = new Map();
const proxyFailKey = (c, port) => `${c.host}:${c.port ?? port}`;
const proxyFailedRecently = (key) => (failedProxies.get(key) ?? 0) > Date.now();
const markProxyKey = (key) => {
  failedProxies.set(key, Date.now() + ProxyFailTtl);
  if (failedProxies.size > 256) for (const [k, v] of failedProxies) if (v <= Date.now()) failedProxies.delete(k);   // 防胀：顺手清过期键
};
const markProxiesFailed = (candidates, port) => { for (const c of candidates) markProxyKey(proxyFailKey(c, port)); };

/** 候选竞速拨号：首包写给最快连上的那个，写失败顺位换下一个 */
const raceDial = async (batch, targetPort, payload) => {
  const shut = (s) => { try { s.close()?.catch?.(() => { }); } catch { } };
  const pending = new Set();
  for (const c of batch) {
    const p = connectWithTimeout(c.host, c.port ?? targetPort).then((socket) => ({ socket, host: c.host, cport: c.port, via: c.via, p }));
    pending.add(p);
    p.catch(() => pending.delete(p));
  }
  while (pending.size) {
    let first;
    try { first = await Promise.any(pending); } catch { break; }   // 这批全都没连上
    pending.delete(first.p);
    try {
      if (payload?.byteLength) {
        const writer = first.socket.writable.getWriter();
        try { await writer.write(payload); } finally { try { writer.releaseLock(); } catch { } }
      }
      for (const p of pending) p.then((r) => shut(r.socket)).catch(() => { });   // 落败者全部关闭，含此刻还没连上的
      return { socket: first.socket, host: first.host, cport: first.cport, via: first.via };
    } catch {
      shut(first.socket);
    }
  }
  throw new Error('all-candidates-failed');
};

/** 逐批把整张候选表都试一遍；失败返回 null */
const dialCandidates = async (candidates, targetPort, payload) => {
  for (let i = 0; i < candidates.length; i += ProxyDialBatch) {
    try {
      return await raceDial(candidates.slice(i, i + ProxyDialBatch), targetPort, payload);
    } catch { }
  }
  return null;
};

/** 建立连接三级：① 直连（Outbound=auto）→ ② 候选反代逐批竞速 → ③ ProxyIPMax 兜底（fixed 无兜底）*/
const establishTcpConnection = async (parsedRequest, request, hostname, payload) => {
  const port = parsedRequest.port;

  // 链接内联出口：/proxyip=host /proxyip.host /pyip= /ip= 或 ?proxyip=host 指定本连接的出站反代，host:port 格式亦可
  const url = new URL(request.url);
  const inlineRaw = (url.searchParams.get('proxyip') || url.searchParams.get('proxy') || url.pathname.match(/\/(?:proxyip|pyip|ip)[.=]([^?#\s]+)/i)?.[1] || '').replace(/\/+$/, '');
  const inlineParsed = inlineRaw ? parseHostPort(inlineRaw) : null;
  const inlineExit = inlineParsed?.host || inlineRaw;
  const inlineExitPort = inlineParsed?.port ?? null;

  const conf = await loadNodeConfig();
  const outbound = String(conf.Outbound ?? 'auto').trim().toLowerCase();
  const forceProxy = outbound === 'global' || outbound === 'fixed';
  // 日志用出站标签：内联出口优先，否则即反代模式本身
  const proxyTag = inlineExit ? 'INLINE' : String(conf.ProxyIPMode || 'AUTO').toUpperCase();
  let tried = 0;

  // 一级：直连（global/fixed 跳过）；CF 预判与拨号并行，判 CF 即弃用直连走反代
  // 预判限时 400ms：超时按非 CF 放行——平台拒绝 Worker 连 CF IP，真 CF 目标在拨号侧自然失败
  if (!forceProxy) {
    let cfTimer;
    const [isCf, direct] = await Promise.all([
      Promise.race([
        resolveHostIps(hostname).then((ips) => ips.every(isCfIp)),
        new Promise((r) => { cfTimer = setTimeout(() => r(false), 400); }),
      ]).finally(() => clearTimeout(cfTimer)),
      raceDial([{ host: hostname, port }], port, payload).catch(() => null),
    ]);
    if (direct && !isCf) {
      logConn(request, '直连', hostname, direct.host, port);
      return { ...direct, exitKey: null };   // 直连出口不记失败记忆
    }
    if (direct) { try { direct.socket.close()?.catch?.(() => { }); } catch { } }   // CF 命中：弃用已拨 socket
  }

  // 二级：候选反代竞速
  try {
    const colo = String(request.cf?.colo || '').toUpperCase();
    const regionHint = coloRegion(colo) ?? request.cf?.country ?? '';
    let candidates = (await resolveProxyCandidates(conf, regionHint, inlineExit, inlineExitPort, hostname, colo)).filter((c) => c?.host);
    // 候选太少时才拆域名（并行解析）
    if (candidates.length && candidates.length <= 2) {
      const expanded = await Promise.all(candidates.map(async (c) =>
        (await resolveHostIps(c.host)).map((ip) => ({ host: ip, port: c.port, via: c.host }))
      ));
      candidates = expanded.flat();
    }
    // 去重后截断
    const seen = new Set();
    candidates = candidates
      .filter((c) => !seen.has(`${c.host}:${c.port ?? port}`) && seen.add(`${c.host}:${c.port ?? port}`))
      .slice(0, ProxyCandidateMax);
    // 跳过 30s 内拨败过的候选
    if (candidates.length > 1) {
      const fresh = candidates.filter((c) => !proxyFailedRecently(proxyFailKey(c, port)));
      if (fresh.length) candidates = fresh;
    }
    tried += candidates.length;
    const hit = await dialCandidates(candidates, port, payload);
    if (hit) { logConn(request, `反代 / ${proxyTag}`, hostname, hit.host, port, hit.via); return { ...hit, exitKey: proxyFailKey({ host: hit.host, port: hit.cport }, port) }; }
    markProxiesFailed(candidates, port); 
  } catch { }

  // 三级：兜底反代（fixed 无兜底）
  if (outbound !== 'fixed') {
    try {
      const fallback = parseHostPort(conf.ProxyIPMax);
      if (fallback?.host) {
        const pool = (await resolveHostIps(fallback.host)).map((ip) => ({ host: ip, port: fallback.port, via: fallback.host }));
        const batch = pool.slice(0, ProxyDialBatch * 2);
        const usable = batch.filter((c) => !proxyFailedRecently(proxyFailKey(c, port)));
        const tryBatch = usable.length ? usable : batch;
        tried += tryBatch.length;
        const hit = await dialCandidates(tryBatch, port, payload);
        if (hit) { logConn(request, '兜底反代', hostname, hit.host, port, hit.via); return { ...hit, exitKey: proxyFailKey({ host: hit.host, port: hit.cport }, port) }; }
        markProxiesFailed(tryBatch, port);
      }
    } catch { }
  }
  logConn(request, `全部失败 / ${proxyTag}`, hostname, `全部失败 [（${tried} ]个节点均无法连接）`, port);
  return null;
};

// ==================== 11. DoH 劫持（53 端口） ====================

const dohEndpoints = ['https://cloudflare-dns.com/dns-query', 'https://dns.google/dns-query'];

/** DoH 端点：合法 URL 单端点直用，否则默认双端点 */
const getDohEndpoints = async () => {
  const v = String((await loadNodeConfig()).Doh ?? '').trim();
  return /^https?:\/\//i.test(v) ? [v] : dohEndpoints;
};

// DoH 应答缓存
const DohCacheMaxEntries = 256;
const dohCache = new Map();

const dnsQuestionKey = (msg) => {
  if (msg.byteLength < 17 || (msg[2] >> 3 & 0xf) !== 0 || ((msg[4] << 8) | msg[5]) === 0) throw 0;
  const labels = [];
  let off = 12;
  for (let l; (l = msg[off]); off++) {
    if (l > 63 || (off += l) + 1 >= msg.byteLength) throw 0;
    labels.push(String.fromCharCode(...msg.subarray(off - l + 1, off + 1)));
  }
  if (off + 5 > msg.byteLength) throw 0;
  return { key: `${labels.join('.').toLowerCase()}/${(msg[off + 1] << 8) | msg[off + 2]}`, end: off + 5 };
};

/** 应答段最小 TTL（毫秒），越界视为不可缓存 */
const dnsMinAnswerTtlMs = (msg, start) => {
  let off = start;
  let ttlMin = Infinity;
  const skipName = () => {
    for (; ;) {
      if (off >= msg.byteLength) throw 0;
      const l = msg[off];
      if (l === 0) { off++; return; }
      if ((l & 0xc0) === 0xc0) { off += 2; return; }   // 压缩指针
      off += l + 1;
    }
  };
  const anCount = (msg[6] << 8) | msg[7];
  if (!anCount || msg[3] & 0xf) throw 0;
  for (let i = 0; i < anCount; i++) {
    skipName();
    if (off + 10 > msg.byteLength) throw 0;
    const rdLen = (msg[off + 8] << 8) | msg[off + 9];
    if (off + 10 + rdLen > msg.byteLength) throw 0;
    ttlMin = Math.min(ttlMin, ((msg[off + 4] << 24 | msg[off + 5] << 16 | msg[off + 6] << 8 | msg[off + 7]) >>> 0));
    off += 10 + rdLen;
  }
  return Math.min(Math.max(ttlMin * 1000, 10 * 1000), 300 * 1000);
};

/** 缓存命中应答 */
const cachedDohAnswer = (entry, dnsQuery) => {
  const out = new Uint8Array(new Uint8Array(entry.data));
  out[0] = dnsQuery[0];
  out[1] = dnsQuery[1];
  return out.buffer;
};

/** DNS 查询转 DoH：缓存 → 主端点先行 + 250ms 对冲补发 → 全失效时用过期缓存兜底 */
const DohHedgeDelay = 250;

const dohQuery = async (dnsQuery) => {
  if (!(dnsQuery instanceof Uint8Array)) dnsQuery = new Uint8Array(dnsQuery);
  let missInfo = null;
  try {
    const { key, end } = dnsQuestionKey(dnsQuery);
    const hit = dohCache.get(key);
    if (hit && Date.now() < hit.expires) {
      dohCache.delete(key), dohCache.set(key, hit);
      return cachedDohAnswer(hit, dnsQuery);
    }
    missInfo = { key, end };
  } catch { }
  const endpoints = await getDohEndpoints();
  const ac = new AbortController();
  const attempt = (endpoint) =>
    fetch(endpoint, {
      method: 'POST',
      headers: { 'content-type': 'application/dns-message' },
      body: dnsQuery,
      signal: ac.signal,
    }).then((r) => {
      if (!r.ok) throw new Error('doh');
      return r.arrayBuffer();
    });
  let resp;
  try {
    resp = await new Promise((resolve, reject) => {
      let settled = false;
      let inflight = 0;
      let queued = endpoints.length - 1; 
      let hedgeTimer = null;
      const settle = (fn, v) => {
        if (settled) return;
        settled = true;
        hedgeTimer && (clearTimeout(hedgeTimer), (hedgeTimer = null));
        clearTimeout(killTimer);
        try { ac.abort(); } catch { }
        fn(v);
      };
      const killTimer = setTimeout(() => settle(reject, new Error('doh-timeout')), 5000);
      const win = (v) => settle(resolve, v);
      const fail = () => { if (!inflight && !queued) settle(reject, new Error('doh')); };
      const launch = (endpoint) => { inflight++; attempt(endpoint).then(win, () => { inflight--; fail(); }); };
      launch(endpoints[0]);
      if (queued > 0) hedgeTimer = setTimeout(() => { hedgeTimer = null; for (const ep of endpoints.slice(1)) { queued--; launch(ep); } }, DohHedgeDelay);
    });
  } catch (e) {
    if (missInfo) {
      const stale = dohCache.get(missInfo.key);
      if (stale) {
        dohCache.delete(missInfo.key), dohCache.set(missInfo.key, stale);
        stale.expires = Date.now() + 10 * 1000;
        return cachedDohAnswer(stale, dnsQuery);
      }
    }
    throw e;
  }
  if (missInfo) {
    try {
      const ttlMs = dnsMinAnswerTtlMs(new Uint8Array(resp), missInfo.end);
      dohCache.set(missInfo.key, { data: resp, expires: Date.now() + ttlMs });
      if (dohCache.size > DohCacheMaxEntries) dohCache.delete(dohCache.keys().next().value);
    } catch { }
  }
  return resp;
};

/* DNS 报文加 2 字节大端长度帧（TCP-DNS / UDP-DNS 回包共用） */
const frameDns = (resp) => {
  const body = resp instanceof Uint8Array ? resp : new Uint8Array(resp);
  const out = new Uint8Array(2 + body.byteLength);
  out[0] = body.byteLength >> 8;
  out[1] = body.byteLength & 0xff;
  out.set(body, 2);
  return out;
};

/* TCP-DNS 封装 */
const dohResolve = async (dnsQuery) => frameDns(await dohQuery(dnsQuery));

/* UDP-DNS 应答 */
const sendUdpDnsAnswer = async (query, writable) => {
  if (!query?.byteLength) return;
  await writable.send(frameDns(await dohQuery(query)));
};

const feedFrames = async (chunk, state, remainKey, writable, close, answer) => {
  if (!chunk?.byteLength) return;
  const remain = state[remainKey];
  let buf = chunk;
  if (remain?.length) {
    buf = new Uint8Array(remain.length + chunk.length);
    buf.set(remain);
    buf.set(chunk, remain.length);
  }
  let off = 0;
  while (buf.length - off >= 2) {
    const len = (buf[off] << 8) | buf[off + 1];
    if (len <= 0 || buf.length - off < 2 + len) break;
    try { await answer(buf.subarray(off + 2, off + 2 + len)); } catch { }
    off += 2 + len;
  }
  if (off >= buf.length) return void (state[remainKey] = null);
  const rest = buf.slice(off);
  if (rest.length > 65537) { state[remainKey] = null; return close(true); }
  state[remainKey] = rest;
};

const feedUdpDns = (chunk, state, writable, close) =>
  feedFrames(chunk, state, 'udpRemain', writable, close, (frame) => sendUdpDnsAnswer(frame, writable));

/** TCP-DNS 持续会话：单连接多查询，空闲 5 分钟收尾 */
const DnsIdleTimeout = 5 * 60 * 1000;

const feedTcpDns = async (chunk, state, writable, close) => {
  state.dnsIdleTimer && clearTimeout(state.dnsIdleTimer);
  state.dnsIdleTimer = setTimeout(() => { state.dnsIdleTimer = null; close(false); }, DnsIdleTimeout);   // 空闲发 1000 关闭
  await feedFrames(chunk, state, 'dnsRemain', writable, close, (frame) => dohResolve(frame).then(writable.send));
};

// ==================== 12. 传输层 ====================

const maxChunkLen = 64 * 1024;                          // 单次切片上限：64KB
const MaxQueuedBytes = 8 * 1024 * 1024;                 // 入站队列字节上限：8MB
const QueueSlots = 2048;                                // 入站环形队列槽位
const FlushTarget = 32 * 1024;                          // 下行攒包目标：32KB
const DirectChunkMin = 32 * 1024;                       // 零拷贝直发下限：32KB
const FirstByteTimeout = 3500;                          // 首字节超时默认值（ms）

/** 首字节看门狗时长（ms），D1 FirstByteTimeout 可覆盖 */
const getFirstByteTimeout = async () => {
  const v = Number((await loadNodeConfig()).FirstByteTimeout);
  return Number.isFinite(v) && v >= 1000 && v <= 30000 ? v : FirstByteTimeout;
};

/** BYOB 手动管道：TCP → WebSocket。
 *  首块 ≥32KB 零拷贝直发，小块攒到 32KB 出帧；只设首字节看门狗，不设空闲看门狗
 *  onBlackhole：看门狗触发（黑洞判定）时回调，把本次出口记入失败记忆 */
const manualPipe = async (readable, writable, close, onBlackhole) => {
  let grain = null;          // 攒包缓冲
  let grainLen = 0;
  let timerId = null;
  let serial = Promise.resolve();
  let serialSendError = null;
  let readBuf = new ArrayBuffer(maxChunkLen);

  // send 链：保序 + 收集首个发送错误
  const sendRaw = (chunk) => {
    serial = serial.then(() => {
      try { writable.send(chunk); } catch (e) { serialSendError ||= e; }
    });
    return serial;
  };

  const flush = async () => {
    timerId && (clearTimeout(timerId), (timerId = null));
    if (grainLen > 0) {
      const out = grain.subarray(0, grainLen);   // 零拷贝出帧
      grainLen = 0;
      await sendRaw(out);
    }
  };

  const reader = readable.getReader({ mode: 'byob' });
  // 首字节看门狗：时限内目标无一字节回传即断开；onBlackhole 把黑洞出口记入失败记忆
  let firstByte = false;
  let stallTimer = setTimeout(() => { stallTimer = null; if (!firstByte) { try { reader.cancel().catch(() => { }); } catch { } if (close) close(true); if (onBlackhole) onBlackhole(); } }, await getFirstByteTimeout());
  const clearStall = () => { if (stallTimer) { clearTimeout(stallTimer); stallTimer = null; } };
  // 块处理：直发（grain 空 & 块够大）或进攒包
  const handleChunk = async (value) => {
    const chunkLen = value?.byteLength || 0;
    if (!chunkLen) return;
    if (!firstByte) { firstByte = true; clearStall(); }
    // grain 有残量且攒不下时先冲掉
    if (grainLen > 0 && grainLen + chunkLen > FlushTarget) await flush();
    if (grainLen === 0 && chunkLen >= DirectChunkMin) {
      // grain 空且块够大：零拷贝直发
      await sendRaw(value.subarray());
    } else {
      grain ||= new Uint8Array(FlushTarget);
      grain.set(value, grainLen);
      grainLen += chunkLen;
      if (grainLen >= FlushTarget) await flush();
      else timerId ||= setTimeout(() => { timerId = null; flush(); }, 1);
    }
  };
  try {
    while (true) {
      const { done, value } = await reader.read(new Uint8Array(readBuf));
      if (done) break;
      if (serialSendError) throw serialSendError; 
      // BYOB 缓冲回收：webSocket.send 同步消费完数据，返回缓冲直接续读（等长校验兜异常实现），稳态零分配
      readBuf = value.buffer.byteLength === maxChunkLen ? value.buffer : new ArrayBuffer(maxChunkLen);
      await handleChunk(value);
    }
  } catch {
    if (close) close(true);   // 读循环异常：静默回收
  } finally {
    clearStall();
    timerId && (clearTimeout(timerId), (timerId = null));
    try { await flush(); } catch { }
    try { await serial; } catch { }
    if (serialSendError && close) close(true);   // 下行 send 失败：清资源
  }
};

/** 微任务环形队列（槽位 QueueSlots + 小包合并 + 字节上限 MaxQueuedBytes） */
const createAsyncMicrotaskQueue = (consume, close) => {
  const queue = new Array(QueueSlots);
  const mask = QueueSlots - 1;
  let head = 0;
  let tail = 0;
  let size = 0;
  let queuedBytes = 0;
  let coalesceBuffer = null;
  let drainActive = false;
  let closed = false;
  let idleNotify = null; 
  const closeQueue = () => {
    if (closed) return;
    closed = true;
    queue.fill(null);
    queuedBytes = 0;
    close?.(true);
    const notify = idleNotify;
    (idleNotify = null), notify?.();
  };
  const shift = () => {
    const chunk = queue[head];
    (queue[head] = null), (head = (head + 1) & mask), size--, (queuedBytes -= chunk.byteLength);
    return chunk;
  };
  const notifyIfIdle = () => {
    if (size === 0 && !drainActive && idleNotify) {
      const notify = idleNotify;
      (idleNotify = null), notify();
    }
  };
  const drainQueue = async () => {
    if (closed) return;
    try {
      while (size > 0 && !closed) {
        if (!enqueue.writer) {
          await consume(shift());
          continue;
        }
        let chunk = queue[head];
        if (chunk.byteLength >= maxChunkLen) {
          await enqueue.writer.write(shift());
          continue;
        }
        let mergedLength = 0;
        coalesceBuffer ||= new Uint8Array(maxChunkLen);
        while (size > 0 && mergedLength + queue[head].byteLength <= maxChunkLen) {
          chunk = shift();
          coalesceBuffer.set(chunk, mergedLength);
          mergedLength += chunk.byteLength;
        }
        if (mergedLength > 0) await enqueue.writer.write(coalesceBuffer.subarray(0, mergedLength));
      }
    } catch {
      closeQueue();
    } finally {
      (drainActive = false), notifyIfIdle();
    }
  };
  const enqueue = (chunk) => {
    if (closed) return;
    chunk = chunk.constructor === Uint8Array ? chunk : new Uint8Array(chunk);
    if (enqueue.writer && !chunk.byteLength) return;
    if (size === QueueSlots || queuedBytes + chunk.byteLength > MaxQueuedBytes) return closeQueue();
    (queue[tail] = chunk), (tail = (tail + 1) & mask), size++, (queuedBytes += chunk.byteLength);
    if (!drainActive) (drainActive = true), queueMicrotask(drainQueue);
  };
  /** 排干通知：队列已空时立即回调 */
  enqueue.onIdle = (cb) => {
    if (closed || (size === 0 && !drainActive)) return cb();
    idleNotify = cb;
  };
  return enqueue;
};

// ==================== 13. 首页伪装反代 ====================

/** 首页伪装固定目标 */
const FakeUrl = 'https://cybermap.kaspersky.com/';

/** 伪装反代：非代理请求反代到 FakeUrl */
const FakeRewriteMax = 2 * 1024 * 1024;
const FakePassHeaders = ['user-agent', 'accept', 'accept-language', 'content-type'];

const handleFakePage = async (request) => {
  const url = new URL(request.url);
  // 缓存键归一化到路径级
  const cacheKey = url.origin + url.pathname;
  const cache = globalThis.caches?.default;
  if (cache && request.method === 'GET') {
    try {
      const hit = await cache.match(cacheKey);
      if (hit) return hit;
    } catch { }
  }
  try {
    const fakeURL = new URL(FakeUrl);
    const headers = new Headers();
    for (const h of FakePassHeaders) {
      const v = request.headers.get(h);
      if (v) headers.set(h, v);
    }
    headers.set('Referer', fakeURL.origin);
    headers.set('Origin', fakeURL.origin);
    headers.set('Accept-Encoding', 'identity');

    const response = await fetchWithTimeout(
      fakeURL.origin + url.pathname + url.search,
      8000,
      { method: request.method, headers, body: request.body },
    );

    const contentType = response.headers.get('content-type') || '';
    if (/text|javascript|json|xml/.test(contentType)) {
      const lenHeader = response.headers.get('content-length');
      const len = lenHeader == null ? NaN : Number(lenHeader);
      const outHeaders = { ...Object.fromEntries(response.headers), 'Cache-Control': 'no-store' };
      // 长度可靠且 ≤2MB 的文本进内存改写，其余流式透传
      if (!Number.isFinite(len) || len > FakeRewriteMax) {
        return new Response(response.body, { status: response.status, headers: outHeaders });
      }
      delete outHeaders['content-encoding'];
      delete outHeaders['content-length'];
      const content = (await response.text()).replaceAll(fakeURL.host, url.host);
      const out = new Response(content, { status: response.status, headers: outHeaders });
      // 成功 GET 文本页写回边缘缓存
      if (cache && request.method === 'GET' && response.status === 200 && !response.headers.has('set-cookie')) {
        try {
          const cachedCopy = out.clone();
          cachedCopy.headers.set('Cache-Control', 'public, max-age=3600');
          cachedCopy.headers.delete('vary');
          await cache.put(cacheKey, cachedCopy);
        } catch { }
      }
      return out;
    }
    return response;
  } catch {
    return unknownResp();
  }
};
