// ==================== 1. 核心凭证 ====================

const AdminVersion = 'v4.2.0';   // 版本
const SyncKey = '1f1825d651b701d611b4fdc4344fdceec29f972cfc37b97d'; // 子后端通信密钥（须与主后端一致，二创请修改）

// ==================== 2. 全局配置 ====================

const NodeDefaults = {

  UUID: 'b69cf773-da16-486e-afce-a45b94f998b3',   // 订阅凭证（与主后端同步；优先级：D1 > 内置默认值）

  ProxyIPMode: 'OFFICIAL',  // 反代模式: OFFICIAL(官方匹配) / AUTO(智能匹配) / 固定地区码(池内18区) / CUSTOM(自定义出口) / LOCAL(在线优选)
  ProxyIP: 'https://proxy.seeck.cn/api/nodes?region=SG,HK&limit=10&format=brand',
  LocalProxyIP: '',       // Local 模式的在线优选出口
  ProxyIPMax: 'Proxy-Auto.SenflareLink.kdns.fr', // 兜底反代（所有模式失效时回退）
  Outbound: 'auto',       // 出站模式: auto(智能分流) / global(全局反代落地,含兜底) / fixed(锁定单反代,无兜底)
  Doh: 'auto',            // DoH 劫持: auto(双端点竞速) / 自定义单端点 URL
  Cache: true,            // 配置缓存总开关
};

/** 配置键白名单（FirstByteTimeout 仅 D1 手工写入，不在主后端推送列表） */
const ConfigKeys = ['UUID', 'ProxyIPMode', 'ProxyIP', 'LocalProxyIP', 'ProxyIPMax', 'Outbound', 'Doh', 'Cache', 'FirstByteTimeout'];

/** 配置缓存时长（5 分钟） */
const ConfigTtl = 5 * 60 * 1000;

// ==================== 3. 运行时状态与配置加载 ====================

/** 运行时 env 引用（fetch 入口捕获） */
let runtimeEnv = null;

/** 全局编解码器 */
const textDecoder = new TextDecoder();
const textEncoder = new TextEncoder();

/** 恒定时间字符串比较 */
const safeEqual = (a, b) => {
  const x = String(a ?? ''), y = String(b ?? '');
  if (x.length !== y.length) return false;
  let diff = 0;
  for (let i = 0; i < x.length; i++) diff |= x.charCodeAt(i) ^ y.charCodeAt(i);
  return diff === 0;
};

/** 节点配置缓存 */
let nodeConf = null;
let nodeConfTime = 0;
/** 配置加载去重 */
let nodeConfInflight = null;

/** D1 故障退避 */
let nodeConfFailUntil = 0;

/** 配置代数：推送落库后推进，用于丢弃读取快照早于本次提交的在途加载 */
let confGeneration = 0;

const normalizeOutbound = (conf) => {
  const outbound = String(conf.Outbound ?? '').trim().toLowerCase();
  const mode = String(conf.ProxyIPMode || '').toUpperCase();
  if (outbound === 'fixed' && mode !== 'CUSTOM' && mode !== 'LOCAL') conf.ProxyIPMode = 'CUSTOM';
  return conf;
};

/** 加载节点配置（5 分钟缓存 + 去重 + 30s 故障退避 + 推送代数校验） */
const loadNodeConfig = async () => {
  const now = Date.now();
  const cacheOn = (nodeConf?.Cache ?? NodeDefaults.Cache) !== false;
  if (cacheOn && nodeConf && now - nodeConfTime < ConfigTtl) return nodeConf;
  if (cacheOn && now < nodeConfFailUntil) return nodeConf ?? { ...NodeDefaults };
  if (nodeConfInflight) return nodeConfInflight;
  nodeConfInflight = (async () => {
    // 推送竞态防护：读取期间 handleSyncConfig 落库会推进代数，本次快照即过期，弃用重读
    // （推送先提交后推进代数，重读必然读到已提交的新值；校验与回填同 tick 无插入点）
    for (let gen = confGeneration; ;) {
      const conf = { ...NodeDefaults };
      let loaded = false;
      const db = runtimeEnv?.Senflare;
      if (db) {
        try {
          const placeholders = ConfigKeys.map(() => '?').join(',');
          const { results } = await db
            .prepare(`SELECT key, value FROM config WHERE key IN (${placeholders})`)
            .bind(...ConfigKeys)
            .all();
          for (const row of results) {
            try {
              conf[row.key] = JSON.parse(row.value);
            } catch {
              conf[row.key] = row.value;
            }
          }
          loaded = true;
        } catch { }
      } else {
        loaded = true; // 无 D1 绑定：纯默认即最终配置
      }

      if (loaded && gen === confGeneration) {
        normalizeOutbound(conf);   // fixed + 非 CUSTOM/LOCAL 回落 CUSTOM
        nodeConf = conf;
        nodeConfTime = Date.now();
        return conf;
      }
      if (!loaded) {
        nodeConfFailUntil = Date.now() + 30 * 1000; // 故障退避：30 秒
        return nodeConf ?? conf;
      }
      gen = confGeneration;   // 快照过期：再读一轮
    }
  })();
  try {
    return await nodeConfInflight;
  } finally {
    nodeConfInflight = null;
  }
};

/** 生效 UUID：优先级 D1 > 内置默认值 */
const isValidUuid = (s) => /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(s);
const getUuid = () => {
  const cfg = String(nodeConf?.UUID || '').trim();
  return isValidUuid(cfg) ? cfg.toLowerCase() : NodeDefaults.UUID;
};

/** UUID 二进制（16 字节）*/
let uuidBytesFor = '';
let uuidBytes = null;
const getUuidBytes = () => {
  const uuid = getUuid();
  if (uuidBytesFor !== uuid) {
    uuidBytes = Uint8Array.from(uuid.replace(/-/g, '').match(/../g), (hex) => parseInt(hex, 16));
    uuidBytesFor = uuid;
  }
  return uuidBytes;
};

// ==================== 4. 通用工具 ====================

/** 二进制地址转字符串（addrType：1=IPv4 / 2=域名 / 3=IPv6） */
const binaryAddrToString = (addrType, addrBytes) => {
  if (addrType === 2) return textDecoder.decode(addrBytes);
  if (addrType === 1) return `${addrBytes[0]}.${addrBytes[1]}.${addrBytes[2]}.${addrBytes[3]}`;
  let ipv6 = ((addrBytes[0] << 8) | addrBytes[1]).toString(16);
  for (let i = 1; i < 8; i++) ipv6 += ':' + ((addrBytes[i * 2] << 8) | addrBytes[i * 2 + 1]).toString(16);
  return `[${ipv6}]`;
};

/** 解析 host:port 条目（支持 IPv6 [host]:port；#备注忽略） */
const parseHostPort = (entry) => {
  const raw = String(entry || '').trim();
  if (!raw) return null;
  const endpoint = raw.split('#')[0].trim();
  let host = endpoint;
  let port = null;
  if (endpoint.charCodeAt(0) === 91) {
    // IPv6: [host]:port
    const idx = endpoint.indexOf(']:');
    if (idx !== -1) {
      host = endpoint.substring(0, idx + 1);
      port = parseInt(endpoint.substring(idx + 2)) || null;
    }
  } else {
    const idx = endpoint.lastIndexOf(':');
    if (idx !== -1) {
      host = endpoint.substring(0, idx);
      port = parseInt(endpoint.substring(idx + 1)) || null;
    }
  }
  return host ? { host, port } : null;
};

/** 带超时的 fetch */
const fetchWithTimeout = async (url, timeout = 8000, init = {}) => {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeout);
  try {
    return await fetch(url, { ...init, signal: ctrl.signal });
  } finally {
    clearTimeout(timer);
  }
};

// ==================== 5. 主入口与路由 ====================

export default {
  async fetch(request, env) {
    runtimeEnv = env;

    // 配置推送接收（密钥不符 404）
    if (request.method === 'POST' && (new URL(request.url)).pathname === '/api/sync/receive-config') {
      return handleSyncConfig(request);
    }

    // XHTTP 优先
    const ct = (request.headers.get('content-type') || '').split(';')[0].trim();
    if (request.method === 'POST' && /^application\/grpc/.test(ct)) {
      await loadNodeConfig();
      return handleXwebPost(request);
    }

    // WebSocket
    if (request.headers.get('Upgrade') === 'websocket') {
      // 先加载配置再握手
      await loadNodeConfig();
      const { 0: clientSocket, 1: webSocket } = new WebSocketPair();
      webSocket.binaryType = 'arraybuffer';
      webSocket.accept();
      handleWebSocketConn(webSocket, request);
      return new Response(null, { status: 101, webSocket: clientSocket, headers: { 'Sec-WebSocket-Extensions': '' } });
    }
    // 其余请求：转发至伪装目标 FakeUrl
    return handleFakePage(request);
  },
};

/** 未知路由响应（200 纯文本） */
function unknownResp() {
  return new Response(
